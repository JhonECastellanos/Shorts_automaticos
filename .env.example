# ── Google Gemini API ──────────────────────────────────────────
# Obtén tu key en: https://aistudio.google.com/app/apikey
# Se soportan hasta 3 keys para rotación automática
GEMINI_API_KEY_1=your_gemini_api_key_here
# GEMINI_API_KEY_2=optional_second_key
# GEMINI_API_KEY_3=optional_third_key

# ── HuggingFace (requerido para pyannote diarización) ──────────
# 1. Crea cuenta en https://huggingface.co
# 2. Acepta los términos del modelo en:
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/pyannote/segmentation-3.0
# 3. Genera un token en: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── OpenRoute API (diarización alternativa) ────────────────────
# Obtén tu key en: https://openrouter.ai/keys
# IMPORTANTE: ya no usar config/settings.yaml para este secreto
OPENROUTE_API_KEY=your_openroute_api_key_here

# ── Base de datos ──────────────────────────────────────────────
# PostgreSQL (producción)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/script_editor
# SQLite (desarrollo, sin servidor)
# DATABASE_URL=sqlite:///./script_editor.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/script_editor

# ── Seguridad JWT ──────────────────────────────────────────────
# CRÍTICO: cambiar en producción. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_SECRET_IN_PRODUCTION_MIN_32_CHARS

# ── Entorno ────────────────────────────────────────────────────
# development | production
APP_ENV=development

# ── CORS Origins ───────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
